#!/usr/bin/env bash
# 관제 전용 파일을 팀원이 실수로 commit하지 않도록 막는다.
#   보호 대상: box_comm/, box_interfaces/, box_bringup/(전체 실행 launch), 각 파트 폴더의 *_template.py
# 켜는 법 (팀원, 처음 한 번): git config core.hooksPath .githooks
# 관제는 이 훅을 켜지 않는다.

protected=$(git diff --cached --name-only --diff-filter=ACDMR | \
  grep -E '^(box_comm/|box_interfaces/|box_bringup/|box_(scan|judge|place|database)/box_(scan|judge|place|database)/[a-z_]+_template\.py$)')

[ -z "$protected" ] && exit 0

echo ""
echo "  ✋ commit 거부: 아래 파일은 관제 전용입니다 (box_comm, box_interfaces, box_bringup, *_template.py)"
echo ""
echo "$protected" | sed 's/^/     - /'
echo ""
echo "  이 파일들만 원래대로 되돌린 뒤 다시 commit 하세요:"
echo ""
echo "$protected" | sed 's/^/     git restore --staged --worktree /'
echo ""
echo "  (새로 만든 파일이라 restore가 안 되면: git rm --cached <파일> 후 파일 삭제)"
echo "  수정이 필요하면 관제(최은정)에게 요청해 주세요."
echo ""
exit 1
