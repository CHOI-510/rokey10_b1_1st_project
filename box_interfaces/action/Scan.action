# Goal: start command + fixed poses (DB values sent by control)
FixedPoses poses       # home_j, measure_zone (from DB via control)
---
bool success
bool found             # false = no more items
string error_code
---
string stage           # see box_comm/common.py STAGES
string log_level       # "" = not a log (progress only) / "INFO" / "WARN" / "ERROR"
string log_msg         # set by report.log(); control forwards it to /event_log
