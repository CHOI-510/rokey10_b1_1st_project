ROBOT_BACKEND=rosbridge
ROSBRIDGE_URL=ws://127.0.0.1:9090
ROSBRIDGE_TIMEOUT=8
BOX_API_URL=http://127.0.0.1:8765
BOX_API_TIMEOUT=8
# box_database 실행 터미널의 BOX_START_TOKEN과 같은 값 (설정한 경우)
BOX_START_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 두산 관절각(deg)·BASE TCP(mm) 읽기 전용 조회, 0.1초 주기
ROBOT_SERVICE_NS=/dsr01/dsr_controller2
ROBOT_TELEMETRY_PERIOD=0.1
